<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pmad.CodeCondenser.Core\Pmad.CodeCondenser.Core.csproj" />
    <ProjectReference Include="..\Pmad.CodeCondenser.Infrastructure\Pmad.CodeCondenser.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codecondenser</ToolCommandName>
    <PackageId>Pmad.CodeCondenser</PackageId>
    <Version>0.1.0-preview</Version>
    <Description>Roslyn-based static analysis CLI tool to detect C# code clones and condense verbose comments via local LLMs.</Description>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jetelain/PmadCodeCondenser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/PmadCodeCondenser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;code-analysis;clone-detection;comments;llm;ollama;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\.agents\skills\**\*" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

</Project>
