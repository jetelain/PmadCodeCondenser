<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>Pmad</Company>
    <Product>Pmad.CodeCondenser</Product>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jetelain/PmadCodeCondenser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);CA1710;CA1716;CA1848;CA1305</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.Contains('Benchmark'))">
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1816;CA1310;CA1866;CA1869;CA1875;CA1822</NoWarn>
  </PropertyGroup>
</Project>
